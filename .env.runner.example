# =====================================================================
# HƯỚNG DẪN CÀI ĐẶT TRÊN MAC SELF-HOSTED RUNNER:
# 1. Copy toàn bộ nội dung file này.
# 2. Trên máy Mac, đi đến thư mục cài đặt GitHub Actions Runner (thường là ~/actions-runner).
# 3. Mở (hoặc tạo mới) file ẩn có tên là `.env` trong thư mục đó.
# 4. Dán nội dung vào, điền các giá trị thực tế của bạn và lưu lại.
# 5. Khởi động lại (restart) ứng dụng runner để nó nhận file .env mới.
# =====================================================================

# ── APPLE / FASTLANE (Dùng chung cho mọi project iOS) ──

# 1. App Store Connect API Key (Lấy tại App Store Connect -> Users and Access -> Keys)
ASC_KEY_ID=YOUR_KEY_ID_HERE
ASC_ISSUER_ID=your-issuer-id-here-0000-000000000000

# Đường dẫn tuyệt đối tới file .p8 trên ổ cứng Mac. Hãy tạo thư mục và copy file .p8 vào đây.
ASC_PRIVATE_KEY_PATH=/Users/runner/ci_keys/AuthKey_YOUR_KEY_ID_HERE.p8

# 2. Apple Developer Account
APPLE_ID=your-apple-id@email.com
APPLE_TEAM_ID=YOUR_TEAM_ID_HERE

# 3. Mật khẩu giải mã chứng chỉ cho Fastlane Match (nếu dùng)
MATCH_PASSWORD=your-match-password-here

# ── GOOGLE PLAY / ANDROID (Dùng chung cho mọi project Android) ──

# Đường dẫn tuyệt đối tới file JSON Service Account lấy từ Google Cloud / Play Console.
# Hãy tải file json về và lưu cố định trên máy Mac tại đây.
GOOGLE_PLAY_KEY_PATH=/Users/runner/ci_keys/play-store-key.json
